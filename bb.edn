{:deps
 {io.github.teodorlu/bb-timemachine {:git/tag "v1.0.1" :git/sha "e684c"}}

 :tasks
 {deploy
  (do (prn 'test)
      (run 'test)
      ;; (prn 'maybe-lint)
      ;; (run 'maybe-lint)
      (prn 'deploy*)
      (run 'deploy*) ; attempt deploy before push avoid startup errors in the git log
      (prn 'push)
      (run 'push)
      )

  deploy*
  (shell "garden deploy")

  dev
  (shell "garden run")

  maybe-lint
  {:requires ([babashka.fs :as fs])
   :task
   (when (fs/which "clj-kondo")         ; linting is optional
     (shell "clj-kondo --fail-level warning --lint src"))}

  push
  (shell "git push")

  test
  (shell "bin/kaocha")

  timemachine
  {:requires ([teodorlu.bb-timemachine :as timemachine])
   :task
   (apply timemachine/timemachine *command-line-args*)}

  test-latest-commit
  (shell "bb timemachine HEAD -- bb test")

  }}
